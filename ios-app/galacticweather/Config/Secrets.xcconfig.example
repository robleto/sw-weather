// Copy this file to Secrets.xcconfig (gitignored) and fill in a real key.
// Get a free key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY = your_key_here

// Analytics. Optional, but a build without it sends nothing at all —
// Services/Analytics.swift is a no-op unless this is set, so a TestFlight
// round built without it produces no retention data. See TESTFLIGHT.md Part 3
// and MEASUREMENT.md.
TELEMETRYDECK_APP_ID = 
